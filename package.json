{
  "name": "tanss-api",
  "description": "TypeScript client for the TANSS API",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "author": "Lukas Neubert (serkonda7)",
  "homepage": "https://github.com/serkonda7/tanss-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/serkonda7/tanss-api"
  },
  "bugs": {
    "url": "https://github.com/serkonda7/tanss-api/issues"
  },
  "keywords": [
    "tanss",
    "api",
    "client"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts -i ./openapi/10.15.0.yaml -o ./src/generated",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && bun run scripts/build.ts",
    "prepack": "bun run generate && bun run build",
    "pack": "bun pm pack --filename tanss-api.tgz"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@hey-api/openapi-ts": "~0.0.0-next-20260824173136",
    "@types/bun": "~1.4.0",
    "typescript": "~7.0.2"
  }
}
